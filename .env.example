# Django
SECRET_KEY=change-me-to-a-random-secret-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL — use DATABASE_URL or discrete POSTGRES_* vars
# Host dev (db only via compose): POSTGRES_HOST=localhost POSTGRES_PORT=5433
# Full compose stack: DATABASE_URL=postgres://stagehand:stagehand@db:5432/stagehand
# DATABASE_URL=postgres://stagehand:stagehand@localhost:5432/stagehand
POSTGRES_DB=stagehand
POSTGRES_USER=stagehand
POSTGRES_PASSWORD=stagehand
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

# Monitor (used by later tickets)
HOST_NAME=talos
METRICS_INTERVAL_SECONDS=10

# Docker (optional — defaults to local socket via DOCKER_HOST)
# DOCKER_HOST=unix:///var/run/docker.sock

# GitHub Actions runners — required for the Runners section on the dashboard.
# Runners are registered at ORG level or REPO level in GitHub; stagehand must
# query the same scope or they will not appear.
#
# Repo-level runners (most common if they show under one project in GitHub):
#   GITHUB_TOKEN=ghp_...
#   GITHUB_REPO=your-user/your-other-project
#   GITHUB_ORG=
#
# Org-level runners (shared across the organization):
#   GITHUB_TOKEN=ghp_...
#   GITHUB_ORG=your-org
#   GITHUB_REPO=
#
# If both ORG and REPO are set, ORG wins. Use only one scope.
# GITHUB_TOKEN=ghp_...
# GITHUB_ORG=
# GITHUB_REPO=owner/repo
# GITHUB_API_URL=https://api.github.com
